---
import config from 'virtual:starlight/user-config'
import { logos } from 'virtual:starlight/user-images'

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute

const words = siteTitle.trim().split(' ')
const lastWord = words.length > 1 ? words.pop() : null
const head = words.join(' ')
---
<a href={siteTitleHref} class="site-title" data-site-title="custom">
  {
    config.logo && logos.dark && (
      <>
        <img
          class:list={[{ 'light:sl-hidden': !('src' in config.logo) }, 'logo-size']}
          alt={config.logo.alt}
          src={logos.dark.src}
          width={logos.dark.width}
          height={logos.dark.height}
        />
        {!('src' in config.logo) && (
          <img
            class="dark:sl-hidden logo-size"
            alt={config.logo.alt}
            src={logos.light?.src}
            width={logos.light?.width}
            height={logos.light?.height}
          />
        )}
      </>
    )
  }
  <span class:list={[{ 'sr-only': config.logo?.replacesTitle }, 'title-text']} translate="no">
    {head}{lastWord && <span class="title-light"> {lastWord}</span>}
  </span>
</a>

<style>
  .site-title {
    gap: 1rem;
    align-items: center;
    display: flex;
    margin-right: 2rem;
    margin-left: 1rem;
  }

  .logo-size {
    width: auto;
    height: 3.5rem;
  }

  .title-text {
    font-weight: 700;
    display: none;
  }

  .title-light {
    font-weight: 200 !important;
    opacity: 0.9;
  }

  @media (min-width: 1024px) {
    .title-text {
      display: inline-block;
    }
  }

  a {
    color: inherit;
    text-decoration: inherit;
  }
</style>
